{
  "manifest_version": 3,
  "name": "Threadline Bluesky Edit & PDS Status",
  "version": "0.6.0",
  "description": "Edit details and PDS status for Bluesky, Mu and Blacksky. https://github.com/marsrakete/ThreadlineBskyEditDetector",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://bsky.app/*",
    "https://mu.social/*",
    "https://*.mu.social/*",
    "https://blacksky.app/*",
    "https://*.blacksky.app/*",
    "https://public.api.bsky.app/*",
    "https://bsky.social/*",
    "https://status.bsky.app/*",
    "https://*.host.bsky.network/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://bsky.app/*",
        "https://mu.social/*",
        "https://*.mu.social/*",
        "https://blacksky.app/*",
        "https://*.blacksky.app/*"
      ],
      "js": [
        "server-status.js",
        "connection.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
